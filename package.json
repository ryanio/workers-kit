{
  "name": "workers-kit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run check:doc-refs && npm run check:consumers && npm run check:peers && npm run check:packages && npm run check:lockfile && npm run lint && npm run build -w packages/start && npm run check --workspaces && npm run deadcode",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "npm test --workspaces",
    "build": "npm run build --workspaces",
    "deadcode": "knip",
    "check:doc-refs": "node packages/doc-refs/bin/doc-refs.mjs",
    "check:consumers": "node scripts/check-consumers.mjs",
    "check:peers": "node scripts/check-peer-ranges.mjs",
    "check:packages": "node scripts/check-package-list.mjs",
    "check:lockfile": "node scripts/check-lockfile-platforms.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "knip": "^6.47.0"
  }
}
