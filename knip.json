{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "packages/start": {
      "entry": ["src/*.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/jobs": {
      "entry": ["src/{index,testing,sqlite}.ts", "test/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
