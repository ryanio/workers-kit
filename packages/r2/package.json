{
  "name": "workers-r2",
  "version": "0.1.0",
  "description": "Presigned Cloudflare R2 upload and download URLs that bind the content type into the signature, and server-side puts, on aws4fetch.",
  "license": "MIT",
  "author": "Ryan Ghods",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanio/workers-kit.git",
    "directory": "packages/r2"
  },
  "homepage": "https://github.com/ryanio/workers-kit/tree/main/packages/r2#readme",
  "bugs": {
    "url": "https://github.com/ryanio/workers-kit/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "r2",
    "s3",
    "presigned-url",
    "sigv4",
    "aws4fetch"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && vitest run",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "aws4fetch": "^1.0.20",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
