{
  "name": "workers-jobs-test",
  "main": "./worker.ts",
  // An older date than most apps use: on it, a failure injected through
  // inlineStep's `fail` surfaces as an unhandled rejection unless it is
  // thrown from a callback, and the inlineStep workerd test checks that.
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobs-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "workflows": [
    {
      "name": "jobs-test",
      "binding": "JOB_WORKFLOW",
      "class_name": "JobWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "JOB_LOCK", "class_name": "JobLockObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JobLockObject"] }],
  "triggers": { "crons": ["0 13 * * *", "*/15 * * * *"] }
}
