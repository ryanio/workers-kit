{
  "name": "workers-jobs",
  "version": "0.7.0",
  "description": "Background jobs for Cloudflare Workers on Cron Triggers and Workflows: typed jobs, deduplicated instance ids, a backstop for dead triggers, and a run ledger for D1 or Postgres.",
  "license": "MIT",
  "author": "Ryan Ghods",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanio/workers-kit.git",
    "directory": "packages/jobs"
  },
  "homepage": "https://github.com/ryanio/workers-kit/tree/main/packages/jobs#readme",
  "bugs": {
    "url": "https://github.com/ryanio/workers-kit/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "workflows",
    "cron",
    "jobs",
    "background-jobs",
    "d1"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./testing/sqlite": {
      "types": "./dist/sqlite.d.ts",
      "import": "./dist/sqlite.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:workerd": "vitest run --project workerd",
    "check": "npm run typecheck && npm run build && vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
