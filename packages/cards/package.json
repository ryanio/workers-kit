{
  "name": "workers-cards",
  "version": "0.1.1",
  "description": "Link preview and social cards drawn in a Cloudflare Worker: a JSX-free element builder for satori, the once-per-isolate wasm boot, WebP pictures decoded for resvg, and the mask stripping that halves a card's render time. No dependencies.",
  "license": "MIT",
  "author": "Ryan Ghods",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanio/workers-kit.git",
    "directory": "packages/cards"
  },
  "homepage": "https://github.com/ryanio/workers-kit/tree/main/packages/cards#readme",
  "bugs": {
    "url": "https://github.com/ryanio/workers-kit/issues"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "satori",
    "resvg",
    "og-image",
    "open-graph",
    "social-card",
    "svg",
    "png"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && vitest run",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^24.19.2",
    "satori": "^0.32.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
